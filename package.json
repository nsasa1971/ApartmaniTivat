{
  "name": "apartmani-tivat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sajt za izdavanje apartmana u Tivtu (HTML + Tailwind CSS + vanilla JS)",
  "scripts": {
    "dev": "tailwindcss -c tailwind.config.cjs -i src/input.css -o assets/css/style.css --watch",
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/input.css -o assets/css/style.css --minify",
    "build:meta": "node scripts/build-meta.mjs",
    "build": "npm run build:css && npm run build:meta",
    "images": "node scripts/optimize-images.mjs",
    "package": "node scripts/package-site.mjs",
    "build:site": "npm run build && npm run package"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17"
  }
}
